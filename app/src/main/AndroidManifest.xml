<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".WebViewActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:documentLaunchMode="always"
            android:theme="@style/WebViewTheme">

            <!-- Markdown / plain text / reader formats (rendered safely, no JS from content) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="text/plain" />
                <data android:scheme="file"    android:mimeType="text/plain" />
                <data android:scheme="content" android:mimeType="text/markdown" />
                <data android:scheme="file"    android:mimeType="text/markdown" />
                <data android:scheme="content" android:mimeType="text/x-markdown" />
                <data android:scheme="file"    android:mimeType="text/x-markdown" />
            </intent-filter>

            <!-- HTML files (rendered as HTML, JS enabled — this is the app runner) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="text/html" />
                <data android:scheme="file"    android:mimeType="text/html" />
                <data android:scheme="content" android:mimeType="application/xhtml+xml" />
                <data android:scheme="file"    android:mimeType="application/xhtml+xml" />
            </intent-filter>

            <!-- Path-pattern fallbacks for file managers that send generic MIME -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" android:host="*"
                      android:pathPattern=".*\\.txt" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" android:host="*"
                      android:pathPattern=".*\\.md" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" android:host="*"
                      android:pathPattern=".*\\.markdown" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" android:host="*"
                      android:pathPattern=".*\\.html" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" android:host="*"
                      android:pathPattern=".*\\.htm" />
            </intent-filter>
        </activity>
    </application>
</manifest>